# 环境变量模板：复制为 .env.development（开发）或 .env（部署）后填写真实值。
# 真实密钥文件已在 .gitignore 中忽略，不要提交到仓库。

# ===== 应用 =====
NODE_ENV=development
PORT=3333
HTTP_TIMEOUT=10000
# 允许跨域的来源，逗号分隔；留空则反射请求来源（仅开发用）
CORS_ORIGIN=

# ===== 认证 =====
# 生产环境必须设置，否则启动直接报错
SESSION_SECRET=change-me-session
JWT_SECRET=change-me-jwt
JWT_EXPIRES_IN=60m
# 首次启动且 user 表为空时自动创建的管理员；留空则生成随机密码打到日志
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mydb
# 是否启动时自动同步表结构；生产请保持 false，用迁移脚本改表
DB_SYNCHRONIZE=true

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 邮件（QQ 邮箱 SMTP 授权码） =====
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ===== 和风天气 =====
WEATHER_API_KEY=

# ===== 飞书机器人 =====
FEISHU_WEBHOOK_URL=
# 机器人开启"签名校验"后必填，否则请求会 403
FEISHU_SECRET=

# ===== MinIO（当前在 AppModule 中未启用） =====
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
